{
	"name": "pi-mailbox",
	"version": "1.3.1",
	"private": true,
	"type": "module",
	"description": "Mailbox service, pi extension, and DeepSeek Harness plugin for cross-session agent messaging, with a host-agnostic core (MailboxController) for embedding",
	"main": "./dist/dsh/index.js",
	"files": [
		"dist",
		"lib",
		"src",
		"mailboxd",
		"dsh.bundle.yml",
		"README.md",
		"package.json"
	],
	"scripts": {
		"build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && esbuild src/dsh/index.ts --bundle --platform=node --format=esm --outfile=dist/dsh/index.js --external:@deepseek-ai/schemastery --external:ws --log-level=warning",
		"check": "tsc --noEmit",
		"check:core": "tsc --noEmit -p tsconfig.core.json",
		"check:dsh": "tsc --noEmit -p tsconfig.dsh.json"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"dsh": {
		"bundle": {
			"patch": "./dsh.bundle.yml"
		},
		"client": {
			"platform": "web",
			"inject": []
		}
	},
	"exports": {
		".": "./dist/dsh/index.js",
		"./client": "./lib/client.js",
		"./core": "./src/core/index.ts"
	},
	"engines": {
		"dsh": ">=0.2.1-rc.2 <0.3.0"
	},
	"dependencies": {
		"@deepseek-ai/schemastery": "3.18.5",
		"ws": "8.22.0"
	},
	"devDependencies": {
		"@types/ws": "8.18.2",
		"esbuild": "^0.28.2",
		"typebox": "^1.3.27",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.99.1",
		"typebox": "*"
	}
}
